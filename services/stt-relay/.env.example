# Template only. Copy to .env on the host that runs the relay. Do not commit .env.
# Cloud Run and any other remote relay must set DEEPGRAM_API_KEY in the service
# environment or Secret Manager. The value never goes in git, the browser, or chat.

DEEPGRAM_API_KEY=
RELAY_AUTH_SECRET=
OMNISTUDIO_LEAD_URL=
OMNISTUDIO_LEAD_TOKEN=
LEAD_SINK_PATH=/tmp/stt-leads.jsonl
ALLOWED_ORIGINS=https://www.sfdc24.com,https://sfdc24.com,http://127.0.0.1:4173,http://127.0.0.1:8765
STT_MAX_SECONDS=180
STT_WARN_SECONDS=30
STT_SESSION_TTL=240
STT_FAKE_UPSTREAM=
